# NoteTube Backend Configuration

# Local LLM Configuration (Ollama)
# When LLM_PROVIDER=ollama, the application runs 100% locally with zero cloud API keys required.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT=120

# Application Configuration
FRONTEND_URL=http://localhost:5173
PORT=8000
HOST=0.0.0.0

# Optional Cloud API Keys (Only used if selecting cloud providers in the UI)
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
